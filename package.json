{
  "name": "@goksening/grimoire",
  "version": "0.0.0",
  "description": "An agent-native issue tracker that lives in your git repo, runs fully locally and syncs only through git.",
  "type": "module",
  "bin": {
    "grimoire": "dist/grimoire.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:cli": "node scripts/build.mjs cli",
    "build:dashboard": "node scripts/build.mjs dashboard",
    "check": "node scripts/check.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "dev:dashboard": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/surfaces/dashboard/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "preact": "^11.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
