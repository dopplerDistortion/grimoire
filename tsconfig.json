{
  // Node side: the CLI/server sources, tests, the harness and the build scripts.
  // The dashboard has its own tsconfig (DOM + Preact JSX) in src/surfaces/dashboard/.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "#harness": ["./test/harness/index.ts"]
    }
  },
  "include": ["src", "test", "scripts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["src/surfaces/dashboard", "dist", "node_modules"]
}
